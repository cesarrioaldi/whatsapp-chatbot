# OpenAI-compatible LLM API Configuration
LLM_API_URL=http://localhost:8080/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-3.5-turbo

# Bot Configuration
BOT_NAME=WhatsApp Assistant
MAX_TOKENS=2000
TEMPERATURE=0.7

# Path to AGENTS.md file (optional)
AGENTS_MD_PATH=./BOT_PROMPT.md

# Database path (optional, default: ./data/diet-tracker.db)
DATABASE_PATH=./data/diet-tracker.db

# Admin Panel Configuration
PANEL_PORT=2999
PANEL_PASSWORD=admin123
MAX_MESSAGE_LENGTH=10000
